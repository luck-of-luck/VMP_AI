        // <<< 9router-auto-models
      },
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}",
      },
      "models": {
        "anthropic/claude-sonnet-4-5": {
          "name": "anthropic/claude-sonnet-4-5",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "google/gemini-3-flash": {
          "name": "google/gemini-3-flash",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "meta-llama/llama-3.3-70b-instruct:free": {
          "name": "meta-llama/llama-3.3-70b-instruct:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
      },
    },
    "github-copilot": {},
    "opencode": {},
    // 2026-10-17 CONSOLIDACAO: bloco "agent" completo migrado de opencode.json
    // para ca (fonte unica). Variants anti-loop aplicados: coder/analyst=high,
    // auditor/researcher=default, explorer/optimizer=low. NENHUM modelo trocado.
  },
  "agent": {
    "explorer": {
      "description": "Fast explorer subagent for codebase exploration",
      "mode": "subagent",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "low",
    },
    "9router-coder": {
      "description": "Coding agent using 9router OpenRouter free models with auto-rotation",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "high",
    },
    "9router-auditor": {
      "description": "Code audit agent using 9router with round-robin rotation",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "default",
    },
    "9router-researcher": {
      "description": "Research agent using 9router free models with auto-fallback",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "default",
    },
    "9router-analyst": {
      "description": "Analysis agent using Kiro Claude models via 9router",
      "mode": "primary",
      "model": "9router/cl/anthropic/claude-sonnet-4.5",
      "variant": "high",
    },
    "9router-optimizer": {
      "description": "Optimization agent using Cohere North Mini Code via 9router",
      "mode": "primary",
      "model": "9router/openrouter/cohere/north-mini-code:free",
      "variant": "low",
    },
    // ===== Multiagente existente (coordenador + equipe vmp-cluster) =====
    // Inicia junto com o 9Router: modelo = 9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free, dados
    // compartilhados via vmp-cluster (board + trilhas em .cluster/).
    "coordenador": {
      "description": "Coordenador da super-equipe. Despacha a equipe via vmp-cluster_cluster_ciclo.",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "max",
    },
    "executor": {
      "description": "Executor — camada 2: age no mundo (edita, testa, corrige com verificacao).",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "max",
    },
    "operario": {
      "description": "Operario — consome a fila do board do vmp-cluster e executa.",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "max",
    },
    "predador": {
      "description": "Revisor com comite de 46 lentes + fatos verificados por scanner deterministico.",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "max",
    },
    "storm": {
      "description": "Piramide viva: comites que tomam funcao por necessidade e nunca param.",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "max",
    },
    "analise": {
      "description": "Analise minuciosa de 15 lentes. So constata, nunca age.",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "max",
    },
    "hermes": {
      "description": "Hermes-aware agent — mensagens e gateway via Hermes MCP.",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "max",
    },
    "hermes-10": {
      "description": "Hermes-aware agent (variante 10) — mensagens e gateway via Hermes MCP.",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "max",
    },
    "navegador": {
      "description": "Navegador interno — usa Playwright MCP para navegar, clicar, preencher e capturar evidência de páginas web.",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "max",
    },
    "reverse-engineer": {
      "description": "Engenharia reversa de sistemas com REA MCP — foco exclusivo em RE.",
      "mode": "primary",
      "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "variant": "high",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
      },
      "prompt": "Você é um especialista em ENGENHARIA REVERSA de sistemas. Sua única função é realizar engenharia reversa com excelência. NÃO escreva código novo, NÃO faça refactoring, NÃO sugira melhorias de código — apenas analise, descompile, desmonte, entenda e documente como sistemas funcionam.\n\nFERRAMENTAS OBRIGATÓRIAS:\n- MCP `rea` (rea-agents): ferramentas de RE de binários, APKs, JavaScript, firmware, EVM, WASM.\n- Skills `reverse-skill` (43 módulos em skills/reverse-skill/skills/): carregar via `skill` tool quando o trabalho casar.\n- `radare2`/`ghidra-reverse`/`ida-reverse`: análise de binários nativos.\n- `apk-reverse`: análise de APKs Android.\n- `js-reverse`: análise de JS ofuscado e assinaturas.\n- `dotnet-reverse`: análise de .NET/C#.\n\nMETODOLOGIA:\n1. IDENTIFICAR o formato (PE/ELF/Mach-O/DEX/APK/WASM/EVM/JS .NET).\n2. COLETAR evidência: strings, imports, exports, símbolos, cross-refs.\n3. DECOMPILAR/DESOMNTAR com a ferramenta correta ao formato.\n4. MAPEAR arquitetura: entry points, fluxos principais, dependências.\n5. DOCUMENTAR com precisão técnica: endereços, offsets, protocolos, algoritmos.\n\nREGRA ABSOLUTA: cada afirmação precisa de evidência (endereço, offset, trecho de código). Distinga OBSERVED / INFERRED / UNKNOWN. NÃO especule sem marcação.",
    },
  },
  // 2026-10-17 CONSOLIDACAO: "9remote" e "mcp_legacy_note" migrados de
  // opencode.json para ca (fonte unica). opencode.json agora e SO arquivo
  // morto (backup) — nao e mais lido para nada util.
  // `plugin` aceita paths LOCAIS tambem (o cluster esta em plugins/cluster/,
  // um nivel abaixo da raiz — o auto-loader so le a raiz, mas o array
  // resolve caminhos). O cluster so mantem os HOOKS dele aqui; as TOOLS
  // chegam pelo MCP `vmp-cluster`, porque tool de plugin nao e registrada
  // no 1.18.34 (medido).
  // 2026-10-17: plugins/cluster/plugin.ts REMOVIDO da lista — ele exporta
  // `export default async () => {...}` e o loader 1.18.34 exige
  // `Plugin export is not a function` (medido no log). As 78 tools do
  // cluster continuam pelo MCP `vmp-cluster`. Para religar: readicionar
  // "./plugins/cluster/plugin.ts" apos corrigir o export.
  "plugin": [],
  "formatter": true,
  // `true` ligava so os LSP embutidos. O objecto LIGA OS EMBUTIDOS E
  // acrescenta os meus, com overrides (confirmado no schema em
  // https://opencode.ai/config.json -> Config.lsp: "an object to enable
  // built-ins with overrides").
  //
  // PORQUE O RUFF E O QUE FAZ SENTIDO AQUI
  // ================================
  // 1. NAO INSTALO NADA. O `ruff server` vem embutido no ruff 0.16.5, que ja
  //    esta no .venv do Ampliagro. Zero risco de conflito de versoes.
  // 2. O PROJECTO JA E STANDARDIZADO EM RUFF: e' o que o pre-commit corre
  //    (ruff + ruff-format) e o que o `ruff.toml` governa. O LSP le o mesmo
  //    ficheiro, portanto o que o editor sublinha e o que o commit rejeita.
  //    Um LSP com regras proprias da diagnose coisas que o commit aceita —
  //    e o pior resultado possivel.
  // 3. NAO CARREGA O DJANGO. E' este o ponto que evita os problemas: um
  //    pylsp-django carrega os settings, e `base.py` levanta `ValueError`
  //    sem `SECRET_KEY` quando DEBUG e' falso. Aqui nao ha settings, nao ha
  //    base de dados, nao ha hang no arranque.
  // 4. E' INSTANTANEO. 623 ficheiros Python sao nada para um servidor em
  //    Rust. pylsp (jedi + plugins) e' lento e pesado nesta dimensao.
  //
  // O QUE ELE NAO FAZ, E E' justO dizer: completamento e go-to-definition.
  // O ruff da diagnosticos, formatacao e code actions (quick fixes) — nao
  // navegacao. Se um dia isso pesar, o complemento de menor risco e o
  // jedi-language-server (tambem nao carrega settings), nunca o pyright
  // (pesado, e os padrões dinamicos do Django geram falsos positivos).
  //
  // MEDIDO: handshake LSP feito a mao contra `ruff server`. Resposta OK com
  // diagnostics, formatting e codeActionProvider. Sem completionProvider.
  // E o que apanha: `ruff check .` da 146 erros, 85 deles em `app/` — a
  // FILA #66 diz "4 avisos", e o numero real e 146.
  "lsp": {
    "ruff": {
      "command": [
        "C:/Trabalho/Projetos/Ativos/Ampliagro/.venv/Scripts/ruff.exe",
        "server",
      ],
    },
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "*": "ask",
    },
    "external_directory": {
      "~/../*": "deny",
      "C:/Windows/**": "deny",
      ".env": "deny",
      "*": "allow",
    },
    "webfetch": "allow",
    "websearch": "allow",
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15,
    "preserve_recent_tokens": 20000,
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 80000,
  },
  "experimental": {
    // MEDIDO: 15000 (15s) era insuficiente para o cluster `vmp-cluster`.
    // Dez agentes com arquivo leem o disco, montam o prompt e consultam o
    // relay: medi 83s numa chamada e 187s noutra (variacao do relay, nao do
    // codigo). Abaixo de 300000 a chamada morre com "Request timed out" e o
    // comite nunca volta.
    //
    // O PRECO, dito com clareza: este limite e GLOBAL. Nos MCPs que travam
    // de verdade, a falha agora aparece em 5 min, nao em 15s. Para MCP que
    // responde, nao muda nada — o limite so e alcancado por quem trava.
    //
    // O MCP `vmp-cluster` se auto-limita antes (CLUSTER_TIMEOUT=270), entao
    // ele devolve um erro HONESTO em vez de deixar o OpenCode reportar
    // timeout cru. Por isso 300 > 270: o de dentro sempre fala primeiro.
    // Se o relay ficar mais lento que isso, o erro sai do MCP — que e o
    // comportamento certo: lente perdida dita como tal, nao como "nenhum
    // problema encontrado".
    "mcp_timeout": 300000,
  },
  "disabled_providers": [],
}
