        // ===== CODEX SWARM (2026-10-18) — 5 contas OAuth ChatGPT =====
        // Round-robin AUTOMATICO entre contas no 9Router.
        // Cada requisicao a um modelo cx/ cai em uma conta diferente —
        // N agentes paralelos = N contas simultaneas sem colidir quota.
        // Testado 2026-10-18: luna e terra respondem com reasoning_effort
        // none|low|medium|high|xhigh. ATENCAO: 'minimal' e rejeitado (400).
        // GONE em conta ChatGPT (nao usar): gpt-5.6-sol, gpt-6*, gpt-6.1*.
        "cx/gpt-5.6-luna": {
          "name": "Codex gpt-5.6-luna (RR 5 contas)",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "reasoning": true,
          "reasoning_options": [
            {
              "type": "effort",
              "values": ["none", "low", "medium", "high", "xhigh"],
            },
