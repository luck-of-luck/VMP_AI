{
  "$schema": "https://opencode.ai/config.json",
  "model": "cline/minimax/minimax-m2.5",
  "small_model": "cline/deepseek/deepseek-chat",
  "instructions": ["AGENTS.md", "SOUL.md", "hermes-agent/AGENTS.md", "hermes-agent/skills/crowork/SKILL.md"],
  "references": {
    "hermes-agent": {
      "path": "./hermes-agent",
      "description": "Hermes Agent source — use for core, gateway, skills, toolsets"
    },
    "hermes-config": {
      "path": "./hermes-agent/AGENTS.md",
      "description": "Hermes invariants: narrow waist, prompt caching"
    },
    "hermes-skills": {
      "path": "./hermes-agent/skills",
      "description": "Catalogo de skills Hermes (16 categorias, 80+ skills) — use via hermes MCP"
    },
    "vortex-skills": {
      "path": "./hermes-agent/skills/vortex",
      "description": "Skills VORTEX_AI: ai-app-orchestration, git-commit-workflow, n8n-operator, visual-browser-user-protocol"
    },
    "opencode-skill": {
      "path": "./hermes-agent/skills/autonomous-ai-agents/opencode",
      "description": "Skill oficial: como delegar para opencode via terminal (opencode run)"
    },
    "vortex-bridge": {
      "path": "./.opencode/skills/vortex-hermes",
      "description": "Bridge VORTEX_AI: opencode + Hermes (skills + MCP) — leia antes de codar no VORTEX"
    },
    "crowork": {
      "path": "./hermes-agent/skills/crowork",
      "description": "CROWORK colaborativo: sala compartilhada transcript+PTY - CLI hermes crowork / TUI /cowork / tools crowork_*"
    }
  },
  "mcp": {
    "hermes": {
      "type": "local",
      "command": ["bin/hermes.exe", "mcp", "serve"],
      "enabled": true,
      "description": "Hermes Agent MCP — 80+ skills, gateway, cron, memory, browser, delegate_task. Requer HERMES_HOME e .env com chave."
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "description": "Context7 — documentacao atualizada de libs/frameworks (ative e adicione header se precisar de auth)"
    },
    "n8n": {
      "type": "local",
      "command": ["hermes-agent/venv/Scripts/python.exe", "../mcp-installs/n8n/server.py"],
      "enabled": false,
      "description": "n8n MCP bridge (instale via: hermes mcp install n8n ou setup.ps1 -WithN8nMCP) — depois habilite aqui e ajuste path para .venv/bin/python no Linux/Mac"
    }
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "cline": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cline (Billing Grátis + ClinePass)",
      "options": {
        "baseURL": "https://api.cline.bot/api/v1",
        "apiKey": "{env:CLINE_API_KEY}"
      },
      "models": {
        "minimax/minimax-m2.5": { "name": "MiniMax M2.5 (grátis/experimentação) - PRINCIPAL" },
        "qwen/qwen3-coder-plus": { "name": "Qwen3 Coder Plus (Cline grátis)" },
        "moonshot/kimi-k2-thinking": { "name": "Kimi K2 Thinking (Cline grátis)" },
        "deepseek/deepseek-chat": { "name": "DeepSeek Chat" },
        "cline-pass/deepseek-v4-flash": { "name": "ClinePass DeepSeek V4 Flash" },
        "cline-pass/qwen3.7-plus": { "name": "ClinePass Qwen3.7 Plus" },
        "cline-pass/glm-5.2": { "name": "ClinePass GLM-5.2" }
      }
    },
    "google": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Google Pro (Gemini - quota alta)",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiKey": "{env:GOOGLE_API_KEY}"
      },
      "models": {
        "gemini-3-flash-preview": { "name": "Gemini 3 Flash Preview (Google Pro)" },
        "gemini-2.5-pro": { "name": "Gemini 2.5 Pro (Google Pro)" },
        "gemini-2.0-flash": { "name": "Gemini 2.0 Flash" },
        "gemini-1.5-pro": { "name": "Gemini 1.5 Pro" }
      }
    },
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Groq (ultra rápido grátis)",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "llama-3.3-70b-versatile": { "name": "Llama 3.3 70B Versatile (Groq)" },
        "qwen/qwen3-32b": { "name": "Qwen3 32B (Groq)" },
        "moonshotai/kimi-k2-instruct": { "name": "Kimi K2 Instruct (Groq)" }
      }
    },
    "cerebras": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebras (free tier)",
      "options": {
        "baseURL": "https://api.cerebras.ai/v1",
        "apiKey": "{env:CEREBRAS_API_KEY}"
      },
      "models": {
        "llama-3.3-70b": { "name": "Llama 3.3 70B (Cerebras)" }
      }
    },
    "together": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Together AI (free)",
      "options": {
        "baseURL": "https://api.together.xyz/v1",
        "apiKey": "{env:TOGETHER_API_KEY}"
      },
      "models": {
        "meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo": { "name": "Llama 3.1 70B Turbo (Together)" }
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute (IAs grátis agregadas)",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "fogueteiros-coding": { "name": "Combo Fogueteiros (Robson) - várias IAs grátis" },
        "teste-um": { "name": "Combo Teste Um" }
      }
    },
    "inferx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "InferX (DeepSeek V4 Flash grátis)",
      "options": {
        "baseURL": "https://api.inferx.net/v1",
        "apiKey": "{env:INFERX_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash 1M (grátis)" }
      }
    },
    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI (GLM-5.2)",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "apiKey": "{env:ZAI_API_KEY}"
      },
      "models": {
        "glm-5.2": { "name": "GLM-5.2 (melhor aberto)" },
        "glm-5.1": { "name": "GLM-5.1" }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nvidia NIM (grátis)",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "meta/llama-3.1-8b-instruct": { "name": "Llama 3.1 8B (Nvidia grátis)" },
        "z-ai/glm-5.1": { "name": "GLM 5.1 via Nvidia" }
      }
    },
    "ollama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5-coder:32b": {
          "name": "Qwen2.5-Coder 32B (offline, 100% grátis)"
        },
        "llama3.3:70b": {
          "name": "Llama 3.3 70B (offline)"
        },
        "deepseek-r1:32b": {
          "name": "DeepSeek R1 32B"
        },
        "qwen2.5:14b": {
          "name": "Qwen2.5 14B (leve)"
        },
        "qwen2.5-coder:14b": {
          "name": "Qwen2.5-Coder 14B"
        }
      }
    },
    "lmstudio-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio Local",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "apiKey": "lmstudio"
      },
      "models": {
        "qwen2.5-coder-14b-instruct": {
          "name": "Qwen2.5-Coder 14B (LM Studio)"
        }
      }
    }
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "edit": "allow",
    "bash": {
      "rm -rf /*": "deny",
      "git push --force *": "deny",
      "*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15,
    "preserve_recent_tokens": 25000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 100000
  }
}
