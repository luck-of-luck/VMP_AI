{
  "$schema": "https://opencode.ai/config.json",
  // MODELO: 9router com modelos OpenRouter :free diretos (servidor atualizado 2026-10-30)
  //
  // O servidor 9Router expõe modelos agora com nomes diretos (sem prefixo 9router/):
  // - openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
  // - openrouter/nvidia/nemotron-3-super-120b-a12b:free
  // - openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
  // - openrouter/cohere/north-mini-code:free
  // - openrouter/poolside/laguna-s-2.1:free
  // - openrouter/nvidia/nemotron-3.5-lightning:free
  // - openrouter/thinkingmachines/inkling-small:free
  // - openrouter/thinkingmachines/inkling:free
  // - openrouter/dots-studio/dots-3-note-preview:free
  // - openrouter/apodex/apodex-1.1-mini:free
  // - oc/nemotron-3-ultra-free, oc/north-mini-code-free, etc.
  // - ocg/space-bunny-free, etc.
  // - cx/gpt-5.6-luna, cx/gpt-5.6-terra (Codex swarm)
  //
  // O combo GRATIS-CODING nao existe mais no servidor 9Router apos a atualizacao.
  // Modelos KR/Kiro migraram para cl/anthropic/claude-sonnet-4.5.
  //
  // Rotação automática via plugin 9router-rotation + fallback-router:
  // - 429/402/quota → troca imediata para próximo modelo
  // - Modelos GONE (virou pago) → removidos permanentemente
  // - Falhas transientes → cooldown 5 min
  // - GitHub Copilot (gpt-4.1/gpt-4o/gpt-4o-mini) → fallback final verificado
  //
  // Medido 2026-10-30: servidor 9Router em http://127.0.0.1:20128/v1 responde com
  // modelos nos prefixos cl/, openrouter/, oc/, ocg/, gh/, cx/. Verificar lista com
  // `opencode models 9router`.
  "model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
  "small_model": "9router/openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
  "default_agent": "build",
  "logLevel": "INFO",
  "share": "manual",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": ["AGENTS.md"],
  "mcp": {
    // ===== Engenharia Reversa & Construcao Cirurgica AGRO (2026-10-17) =====
    // Arsenal keyless + local para: RE de apps/ERPs legados, BDs gigantes,
    // APIs agro (defensivos, clima, NDVI, cotações), protocolos de campo.
    // HIERARQUIA DE CONTEXTO (não carrega tudo de uma vez):
    // - codebase-memory-mcp (grafo) SEMPRE primeiro — já ativo.
    // - reverse-skill = skill FILE-BASED (43 SKILL.md em skills/reverse-skill).
    //   Carrega via `skill` tool SÓ quando o trabalho casar (RE/APK/ERP/BD/API).
    // - MCPs abaixo = execução (cada um expõe tools). Todos keyless/locais.
    // NADA aqui exige API key. NADA remove provider/modelo existente.
    // 2026-10-17: MCP `sqlite` REMOVIDO — duplicava `sqlite-ampliagro`
    // (mesmo binário, mesmo db.sqlite3). Duas instâncias no mesmo arquivo
    // = Connection closed por lock. O legado continua valendo; habilitar
    // lá quando precisar. Ver bloco `sqlite-ampliagro` abaixo.
    // Postgres READ-ONLY para ERPs/BDs gigantes (Totvs, Senior, SAP B1, custom).
    // Seguro por construção: só SELECT. Apontar connectionString por projeto.
    // Pacote oficial DEPRECADO (@modelcontextprotocol/server-postgres) —
    // usa o fork mantido `crystaldba/postgres-mcp` via npx. Mantido
    // DESABILITADO até configurar a string: trocar enabled + DATABASE_URI.
    "postgres-ro": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        "postgres-mcp",
        "--read-only",
      ],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
        "DATABASE_URI": "postgresql://readonly:readonly@localhost:5432/agro",
      },
      "enabled": false,
    },
    // Diff cirúrgico via GIT (o que mudou entre versões do ERP/app):
    // pickaxe (-S "funcao") acha quem introduziu/removeu um cálculo.
    // Substitui o "binary-diff" (pacote inexistente no PyPI) — git cobre
    // 100% do caso ERP/app com código-fonte; binário puro vai pelo
    // radare2/ghidra via skill reverse-skill.
    "git-history": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        "mcp-server-git-history",
      ],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
      },
      "enabled": true,
    },
    // HTTP replay/observabilidade: captura request/response de API agro
    // (ex.: API de defensivo com assinatura HMAC) para reproduzir em Node.
    "http-replay": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        "@modelcontextprotocol/server-everything",
      ],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
      },
      "enabled": true,
    },
    // Shadcn/UI RAD: gera telas de ERP agro (talhão, aplicação, estoque)
    // com React+Tailwind seguindo web-design-guidelines.
    "shadcn-ui": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        "@jpisnice/shadcn-ui-mcp-server",
      ],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
      },
      "enabled": true,
    },
    // ===== Engenharia Reversa (REA MCP) =====
    // npx rea-agents mcp — reverse engineer anything from terminal or agent.
    // Skills: reverse-skill (43 SKILL.md) — carregar via `skill` tool quando casar.
    "rea": {
      "type": "local",
      "command": ["C:/Program Files/nodejs/npx.cmd", "-y", "rea-agents", "mcp"],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
      },
      "enabled": true,
    },
    // ===== FIM bloco AGRO =====
    // ===== Infraestrutura existente =====
    "hermes": {
      "type": "local",
      "command": [
        "bin/hermes.exe",
        "mcp",
        "serve",
      ],
      "enabled": true,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },

    // ===== RaciocÃ­nio & MemÃ³ria =====
    "sequential-thinking": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking",
      ],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
      },
      "enabled": true,
    },
    "memory": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        "@modelcontextprotocol/server-memory",
      ],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
        "MEMORY_FILE_PATH": "memory.json",
      },
      "enabled": true,
    },
    "time": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-time",
        "--local-timezone",
        "America/Sao_Paulo",
      ],
      "environment": { "PATH": "bin" },
      "enabled": true,
    },
    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch",
      ],
      "environment": { "PATH": "bin" },
      "enabled": true,
    },
    "arxiv": {
      "type": "local",
      "command": [
        "uvx",
        "arxiv-mcp-server",
      ],
      "environment": {
        "PATH": "bin",
        "ARXIV_STORAGE_PATH": "arxiv-papers",
      },
      "enabled": true,
    },

    // ===== Clima & AgronegÃ³cio (keyless) =====
    "open-meteo": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        "@cyanheads/open-meteo-mcp-server",
      ],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
      },
      "enabled": true,
    },
    "open-meteo-pro": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        "open-meteo-mcp-server",
      ],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
      },
      "enabled": true,
    },
    // CORRIGIDO em duas etapas, ambas medidas:
    // 1. o executavel chama-se agriculture-server, nao agriculture-mcp-server
    //    (uvx: "An executable named 'agriculture-mcp-server' is not provided")
    // 2. o pacote usa FastMCP, removido no MCP 2.x. O proprio traceback pedia
    //    o pin. Com --with "mcp<2" sobe: medido 8 tools (climate_averages,
    //    crop_weather_forecast, soil_conditions, food_search...).
    "agriculture": {
      "type": "local",
      "command": [
        "uvx",
        "--quiet",
        "--with",
        "mcp<2",
        "--from",
        "agriculture-mcp-server",
        "agriculture-server",
      ],
      "environment": { "PATH": "bin" },
      "enabled": true,
    },

    // ===== Busca & Dev =====
    "duckduckgo": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        "duckduckgo-mcp-server",
      ],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
      },
      "enabled": true,
    },
    // 2026-10-17: MCP `github` (api.githubcopilot.com/mcp) retorna 400 sem
    // Authorization valida no handshake SSE (medido: "missing required
    // Authorization header" no GET, "Non-200 (400)" no `mcp list`).
    // O token GITHUB_TOKEN existe mas o endpoint espera OAuth do Copilot,
    // nao PAT. Mantido DESABILITADO ate confirmar o formato certo —
    // NADA apagado, so `enabled: false`. O provider `github-copilot`
    // (modelos) continua funcionando normal via auth.json.
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer {env:GITHUB_TOKEN}" },
      "enabled": false,
    },
    // DESLIGADO de proposito: mcp-server-sqlite esta QUEBRADO no SDK MCP
    // atual. Medido na ultima versao do PyPI (2025.4.25):
    //   AttributeError: 'Server' object has no attribute 'list_resources'
    // O pacote foi arquivado e usa um decorator removido do SDK. Nao ha
    // versao nova nem caminho alternativo que conserte — nao e problema de
    // PATH. Deixava ligado, gastava contexto com uma tool que nunca responde.
    // Alternativa enquanto isso: o MCP "db" (mcp-database) cobre SQLite com
    // 39 tools e foi verificado funcional.
    "sqlite-ampliagro": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        "C:/Trabalho/Projetos/Ativos/Ampliagro/db.sqlite3",
      ],
      "enabled": false,
    },
    // ===== AmplIA â€” a IA local do Ampliagro, por MCP (stdio) =====
    // 76 intents do sandbox + catÃ¡logo de ecrÃ£s e de capacidades.
    // SO LEITURA por omissÃ£o: as 24 tools que alteram dados ficam
    // bloqueadas. Para as abrir, acrescente "--permitir-escrita" aos args.
    // DiagnÃ³stico: manage.py amplia_mcp doctor
    "amplia": {
      "type": "local",
      "command": [
        "C:/Trabalho/Projetos/Ativos/Ampliagro/.venv/Scripts/python.exe",
        "C:/Trabalho/Projetos/Ativos/Ampliagro/app/amplia_mcp/servidor.py",
        "--usuario",
        "demo",
      ],
      "enabled": true,
    },
    // ===== Cluster de 10 IAs (VMP-AI) =====
    // Tools de plugin NAO funcionam no OpenCode 1.18.34 (medido: nem um
    // plugin minimo registra tool). MCP funciona — 78 tools amplia_* ativas.
    // Entao o cluster e MCP: este processo -> HTTP -> engine.ts.
    "vmp-cluster": {
      "type": "local",
      "command": [
        "hermes-agent/venv/Scripts/python.exe",
        "VMP-AI/cluster/mcp_server.py",
      ],
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["C:/Program Files/nodejs/npx.cmd", "-y", "@playwright/mcp"],
      "environment": {
        "PATH": "C:/Program Files/nodejs;bin",
      },
      "enabled": true,
    },

    // ===== Predador: verificacao DETERMINISTICA =====
    // O comite (46 lentes) e 100% probabilistico: ele OPINA.
    // Estes servers CONSTATAM. Regra casa regra, nao e achismo.
    // Fato vs opiniao passa a ser uma distincao medivel.

    // 59 tools. Medidas via tools/list real, nao pelo README.
    // ATENCAO: o entry point publicado do repo ("main:run_mcp_server")
    // QUEBRA instalado — main.py fica na raiz do repo e nao vai para o
    // venv, entao "from main import ..." falha com ModuleNotFoundError.
    // Contornado rodando main.py direto (o diretorio de um script ENTRA no
    // sys.path; o de um console-script instalado, nao).
    // Depende do binario: npm i -g @ast-grep/cli --allow-scripts=@ast-grep/cli
    // O postinstall baixa o binario nativo. Sem --allow-scripts o npm
    // bloqueia e a busca estrutural falha em silencio (exit 1, 0 matches).
    "astgrep": {
      "type": "local",
      "command": [
        "VMP-AI/mcps/ast-grep-mcp/.venv/Scripts/python.exe",
        "VMP-AI/mcps/ast-grep-mcp/main.py",
      ],
      "environment": {
        "AST_GREP_PATH": "ast-grep",
      },
      "enabled": true,
    },

    // Semgrep CE: 10k+ regras, 100% local, sem upload de codigo.
    // Medido v1.179.0. Ele mesmo avisa sem o Pro Engine e roda em CE.
    // CAMINHO ABSOLUTO de propósito: "uvx" como nome solto FALHA no boot
    // (medido: executable not found) — o uvx daqui e um shim em hermes\bin,
    // que pode nao estar no PATH do processo que o OpenCode spawna.
    // Startup medido: ~14s (baixa/cachea semgrep na primeira vez).
    "semgrep": {
      "type": "local",
      "command": [
        "uvx",
        "--quiet",
        "semgrep",
        "mcp",
      ],
      "enabled": true,
    },

    // SAST multi-scanner. Medido: 11 scanners registrados, 4 respondendo
    // (bandit 1.9.4, njsscan 0.4.2, checkov 3.1.47, semgrep 1.178.0).
    // Os outros 7 (trivy, grype, gitleaks, osv, bearer, codeql, zap) sao
    // binarios/Docker — sem Docker neste host, ficam "missing".
    //
    // SHIM checkov.exe (build/checkov-shim.cs): necessario porque o scanner
    // roda via create_subprocess_exec(["checkov"]) e no Windows esse lookup
    // acha SO .exe — o pip/uv so geram checkov.cmd, dando FileNotFoundError
    // e get_version() -> None. O shim chama o python do venv via um .py
    // (nao -c: o ProcessStartInfo do .NET 2.0 quebra com aspas no codigo).
    // PATH precisa apontar para o venv\Scripts: bandit/semgrep usam nome
    // solto, e o MCP nao herda o PATH do venv.
    "sast": {
      "type": "local",
      "command": [
        "VMP-AI/mcps/sast-mcp/.venv/Scripts/python.exe",
        "-m",
        "sast_mcp_server.server",
      ],
      "environment": {
        "PATH": "VMP-AI/mcps/sast-mcp/.venv/Scripts;AppData/Roaming/npm;C:/Program Files/nodejs",
      },
      "enabled": true,
    },

    // 39 tools: db_perf_diagnose/explain/blocking/index_advisor,
    // db_read_query, db_schema_*, db_admin_*.
    // ATENCAO: este servidor NAO sobe sem uma URI real — sem ela ele morre
    // ANTES de registrar as tools ("URI is required"). Verificado.
    // Por isso entra com um SQLite local em read_only: e o unico engine que
    // existe sem servidor. Para apontar em Postgres/MySQL/Mongo/Redis, troca
    // a URI + ENGINE_TYPE abaixo pelo seu banco.
    "db": {
      "type": "local",
      "command": [
        "VMP-AI/mcps/mcp-database/.venv/Scripts/python.exe",
        "-c",
        "from mcp_database.entry import main; main()",
      ],
      "environment": {
        "URI": "sqlite:///./VMP-AI/mcps/predador.db",
        "ENGINE_TYPE": "sqlite",
        "MODE": "read_only",
      },
      "enabled": true,
    },

    // ===== Desativados (ver mcp-registry.json para habilitar) =====
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false,
    },
    "codebase-memory-mcp": {
      "command": [
        "codebase-memory-mcp",
      ],
      "type": "local",
    },
    "dsh-mcp": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/node.exe",
        "mcps/dsh-mcp/index.js",
      ],
      "environment": {
        "PATH": "bin",
      },
      "enabled": true,
    },
  },
  "providers": {
    "9router": {
      // OpenCode v2: "npm"/"options" (v1) são ignorados -> "Unsupported package".
      // Use "package" + "settings".
      "name": "9router",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1",
        "apiKey": "{env:NINEROUTER_API_KEY}",
      },
      "models": {
        // Kiro (conexão independente via 9Router) — prefixo cl/ conforme lista do servidor (medido 2026-10-30)
        "cl/anthropic/claude-sonnet-4.5": {
          "name": "cl/anthropic/claude-sonnet-4.5",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "cl/anthropic/claude-sonnet-4": {
          "name": "cl/anthropic/claude-sonnet-4",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        // OpenRouter :free via 9Router — nomes diretos conforme lista do servidor (medido 2026-10-30)
        "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free": {
          "name": "openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/cohere/north-mini-code:free": {
          "name": "openrouter/cohere/north-mini-code:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/poolside/laguna-s-2.1:free": {
          "name": "openrouter/poolside/laguna-s-2.1:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/nvidia/nemotron-3.5-lightning:free": {
          "name": "openrouter/nvidia/nemotron-3.5-lightning:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/thinkingmachines/inkling-small:free": {
          "name": "openrouter/thinkingmachines/inkling-small:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/thinkingmachines/inkling:free": {
          "name": "openrouter/thinkingmachines/inkling:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/dots-studio/dots-3-note-preview:free": {
          "name": "openrouter/dots-studio/dots-3-note-preview:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/apodex/apodex-1.1-mini:free": {
          "name": "openrouter/apodex/apodex-1.1-mini:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/nvidia/nemotron-3-nano-30b-a3b:free": {
          "name": "openrouter/nvidia/nemotron-3-nano-30b-a3b:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/google/gemma-4-26b-a4b-it:free": {
          "name": "openrouter/google/gemma-4-26b-a4b-it:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/google/gemma-4-31b-it:free": {
          "name": "openrouter/google/gemma-4-31b-it:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/poolside/laguna-m.1:free": {
          "name": "openrouter/poolside/laguna-m.1:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/poolside/laguna-xs-2.1:free": {
          "name": "openrouter/poolside/laguna-xs-2.1:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "openrouter/inclusionai/ling-3.0-flash:free": {
          "name": "openrouter/inclusionai/ling-3.0-flash:free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        // Modelos OpenCode curadoria free (oc/) — confirmados no servidor 9Router (medido 2026-10-30)
        "oc/nemotron-3-ultra-free": {
          "name": "oc/nemotron-3-ultra-free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "oc/north-mini-code-free": {
          "name": "oc/north-mini-code-free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "oc/laguna-s-2.1-free": {
          "name": "oc/laguna-s-2.1-free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "oc/ling-3.0-flash-free": {
          "name": "oc/ling-3.0-flash-free",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
        },
        "oc/mimo-v2.5-free": {
          "name": "oc/mimo-v2.5-free",
          "modalities": {
            "input": ["text"],
